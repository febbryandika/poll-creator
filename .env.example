# Copy the relevant keys into each package's local env file:
#   apps/api/.env         DATABASE_URL, UPSTASH_*, PORT   (Bun auto-loads .env)
#   apps/web/.env.local   NEXT_PUBLIC_API_URL, DATABASE_URL, BETTER_AUTH_*, GOOGLE_*  (Next auto-loads)
#   packages/db/.env      DATABASE_URL                    (drizzle-kit loads via dotenv)
#
# For the local Postgres container, copy this file to a repo-root ./.env —
# docker/podman compose reads POSTGRES_PORT from there (see below).

# ── docker compose: local Postgres (repo-root ./.env) ──
# Host port the container publishes. Default 5432; override if it's taken on your
# machine, then match the same port in DATABASE_URL below.
POSTGRES_PORT=5432

# ── Postgres (packages/db + apps/api) ──
# Local container (docker-compose.yml) or a Neon connection string.
# When using the local container, keep this port in sync with POSTGRES_PORT.
DATABASE_URL=postgresql://poll:poll@localhost:5432/poll_creator

# ── apps/api (public real-time surface) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PORT=8787

# ── apps/web (Next.js — NEXT_PUBLIC_* is exposed to the browser) ──
NEXT_PUBLIC_API_URL=http://localhost:8787

# ── apps/web (Better Auth — also needs DATABASE_URL from above) ──
BETTER_AUTH_SECRET=            # generate: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth — redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
